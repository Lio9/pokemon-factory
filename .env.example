# ==========================================
# Pokemon Factory — 环境变量示例
# ==========================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ─── JWT ───────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret

# ─── 前端端口 ──────────────────────────────
FRONTEND_PORT=7894

# ─── 后端端口 ──────────────────────────────
# BACKEND_PORT=8084

# ─── 数据库 ────────────────────────────────
# SQLite 数据库文件路径（Java 后端使用）
# SQLITE_DB_URL=jdbc:sqlite:backend/pokemon-factory.db
# SQLITE_DB_PATH=./backend/pokemon-factory.db

# ─── 前端 API 地址 ─────────────────────────
# VITE_API_BASE=/api/pokedex
# VITE_SPRITES_BASE=/api/pokedex/images
# VITE_DAMAGE_API_BASE=/api/damage
