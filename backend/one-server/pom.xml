<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lio9</groupId>
        <artifactId>pokemon-factory</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>one-server</artifactId>
    <name>Pokemon Factory — One Server</name>
    <description>Combined server: PokeDex + Battle + User + Common in one JAR</description>

    <dependencies>
        <dependency>
            <groupId>com.lio9</groupId>
            <artifactId>battle</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lio9</groupId>
            <artifactId>pokedex</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.lio9.server.OneServerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
