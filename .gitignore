# Pokemon Factory .gitignore

# ========================
# 敏感数据
# ========================
config/secrets.yml
secrets.json
credentials.json

# ========================
# 环境变量
# ========================
.env.local
.env.*.local
.env.production.local
frontend/.env
**/config/jwt.key

# ========================
# Python (scripts/)
# ========================
__pycache__/
*.py[cod]
venv/
.venv/

# ========================
# Java / Maven
# ========================
target/
*.iws
*.iml
*.ipr
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml

# ========================
# 前端 (Node / Vite / Vue)
# ========================
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
.npm-cache/
.eslintcache
coverage/
.cache/

# ========================
# 数据库
# ========================
*.db
*.sqlite
*.sqlite3
*.bak
*.bak.*
!pokemon-factory-backend/common/src/main/resources/db/**/*.sql

# ========================
# 旧构建目录（无源码，纯 target/ 产物）
# ========================
pokemon-factory-backend/

# ========================
# IDE
# ========================
.vscode/
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.code-workspace

# ========================
# OS
# ========================
.DS_Store
Thumbs.db
[Dd]esktop.ini

# ========================
# 日志
# ========================
logs/
*.log
*.log.gz
*.err

# ========================
# 原始数据 (PokeAPI CSV)
# ========================
csv/

# PokeAPI JSON 缓存
data/pokeapi-cache/

# ========================
# 临时文件
# ========================
*.tmp
*.swp

# ========================
# 测试覆盖率
# ========================
.history/

# ========================
# IDE / AI 配置
# ========================
.claude/
.deepseek/

# ========================
# 数据库备份
# ========================
backups/

# ========================
# 其他
# ========================
data/image/pokemon/
data/image/*.png

# SQLite WAL/SHM
*.db-shm
*.db-wal
data/image/_failed.json
data/image/_failed.json
data/image/_failed_back.json
